{
    "info":  {
                 "_postman_id":  "836f91be-5abc-48ec-9c79-a4e11c9ef9b1",
                 "name":  "SiteCare API",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "variable":  [
                     {
                         "key":  "baseUrl",
                         "value":  "http://localhost:8000"
                     },
                     {
                         "key":  "csrf",
                         "value":  ""
                     },
                     {
                         "key":  "ticketId",
                         "value":  "1"
                     },
                     {
                         "key":  "invitationToken",
                         "value":  ""
                     },
                     {
                         "key":  "websiteId",
                         "value":  "1"
                     },
                     {
                         "key":  "timestamp",
                         "value":  ""
                     },
                     {
                         "key":  "eventId",
                         "value":  ""
                     },
                     {
                         "key":  "signature",
                         "value":  ""
                     }
                 ],
    "event":  [
                  {
                      "listen":  "prerequest",
                      "script":  {
                                     "type":  "text/javascript",
                                     "exec":  [
                                                  "if (pm.request.method !== \u0027GET\u0027) {",
                                                  "  const xsrf = pm.cookies.get(\u0027XSRF-TOKEN\u0027);",
                                                  "  if (xsrf) pm.request.headers.upsert({key:\u0027X-XSRF-TOKEN\u0027, value:decodeURIComponent(xsrf)});",
                                                  "}"
                                              ]
                                 }
                  }
              ],
    "item":  [
                 {
                     "name":  "Health",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/health"
                                 }
                 },
                 {
                     "name":  "Get CSRF cookie",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/sanctum/csrf-cookie"
                                 }
                 },
                 {
                     "name":  "Login",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"email\": \"client@sitecare.test\",\n  \"password\": \"password\"\n}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/auth/login"
                                 }
                 },
                 {
                     "name":  "Current user",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/v1/auth/me"
                                 }
                 },
                 {
                     "name":  "Dashboard",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/v1/dashboard"
                                 }
                 },
                 {
                     "name":  "Websites",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/v1/websites"
                                 }
                 },
                 {
                     "name":  "Submit website",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"name\": \"Example production site\",\n  \"url\": \"https://example.com\",\n  \"description\": \"Demo submission\"\n}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/websites"
                                 }
                 },
                 {
                     "name":  "Tickets",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/v1/tickets"
                                 }
                 },
                 {
                     "name":  "Add ticket comment",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"body\": \"I can provide more details if needed.\"\n}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/tickets/{{ticketId}}/comments"
                                 }
                 },
                 {
                     "name":  "Logout",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/v1/auth/logout"
                                 }
                 },
                 {
                     "name":  "Create invitation",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"email\":\"new-client@example.test\",\"role\":\"client\",\"organisation_id\":1}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/invitations"
                                 }
                 },
                 {
                     "name":  "Accept invitation",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"token\":\"{{invitationToken}}\",\"email\":\"new-client@example.test\",\"name\":\"New Client\",\"password\":\"long-development-password\",\"password_confirmation\":\"long-development-password\"}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/invitations/accept"
                                 }
                 },
                 {
                     "name":  "Backup history",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/v1/websites/{{websiteId}}/backups"
                                 }
                 },
                 {
                     "name":  "Rotate backup webhook secret",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/v1/websites/{{websiteId}}/backup-webhook-secret"
                                 }
                 },
                 {
                     "name":  "Signed backup webhook",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "X-SiteCare-Timestamp",
                                                        "value":  "{{timestamp}}"
                                                    },
                                                    {
                                                        "key":  "X-SiteCare-Event-Id",
                                                        "value":  "{{eventId}}"
                                                    },
                                                    {
                                                        "key":  "X-SiteCare-Signature",
                                                        "value":  "{{signature}}"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"type\":\"full_site\",\"status\":\"completed\",\"completed_at\":\"2026-10-01T10:00:00Z\",\"verified\":false}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/webhooks/websites/{{websiteId}}/backups"
                                 }
                 },
                 {
                     "name":  "Ticket categories",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [{"key":"Accept","value":"application/json"}],
                                     "url":  "{{baseUrl}}/api/v1/ticket-categories"
                                 }
                 },
                 {
                     "name":  "Platform settings",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [{"key":"Accept","value":"application/json"}],
                                     "url":  "{{baseUrl}}/api/v1/platform-settings"
                                 }
                 },
                 {
                     "name":  "Update response targets (admin)",
                     "request":  {
                                     "method":  "PATCH",
                                     "header":  [
                                                    {"key":"Accept","value":"application/json"},
                                                    {"key":"Content-Type","value":"application/json"}
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"ticket_response_targets\":{\"low\":72,\"normal\":24,\"high\":4,\"urgent\":1}}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/platform-settings"
                                 }
                 },
                 {
                     "name":  "Request password reset",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {"key":"Accept","value":"application/json"},
                                                    {"key":"Content-Type","value":"application/json"}
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"email\":\"client@sitecare.test\"}"
                                              },
                                     "url":  "{{baseUrl}}/api/v1/auth/forgot-password"
                                 }
                 }
             ]
}
